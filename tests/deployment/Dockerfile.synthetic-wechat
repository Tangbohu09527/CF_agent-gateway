ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 wechat \
    && useradd --uid 1000 --gid 1000 --no-create-home wechat \
    && ln -s /usr/bin/sleep /usr/bin/wechat
COPY tests/deployment/external_services.py /external_services.py
CMD ["python", "/external_services.py", "wechat"]
