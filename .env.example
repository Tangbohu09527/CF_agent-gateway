# Application settings. Keep the real file readable only by the service account.
CF_GATEWAY_CONFIG=/etc/cf-agent-gateway/production.yaml
CF_AGENT_GATEWAY_DATABASE_URL=postgresql+psycopg://cf_agent_gateway:replace-me@postgres.example.internal:5432/cf_agent_gateway?connect_timeout=5
CF_GATEWAY_STARTUP_MIGRATION_MODE=check
CF_GATEWAY_LOG_LEVEL=INFO

# HTTP credentials. Use distinct, high-entropy values in the real protected env file.
CF_GATEWAY_API_TOKEN=
CF_AGENT_GATEWAY_ADMIN_TOKEN=

# Dispatch worker execution limits. Environment values override worker.* in YAML.
CF_GATEWAY_WORKER_CONCURRENCY=4
CF_GATEWAY_WORKER_LEASE_SECONDS=60
CF_GATEWAY_WORKER_RETRY_LIMIT=3

# Worker liveness. Compose services and systemd units override the path per process.
# The maximum age used by deployment health checks is 30 seconds.
CF_GATEWAY_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
CF_GATEWAY_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
CF_GATEWAY_RUNTIME_HEARTBEAT_MAX_AGE_SECONDS=30

# Adapter credentials. Leave unset when the corresponding adapter is disabled.
# Production Compose reads agent-wechat authentication only from this host file.
CF_AGENT_WECHAT_TOKEN_HOST_FILE=/srv/storage/cf-agent-wechat/secrets/auth-token
HERMES_API_KEY=

# First installation builds fixed source and records its Image ID.
# See deploy/install-clean-device.sh and docs/deployment/clean-device.md.
# Existing deployments supply their approved immutable image.
CF_GATEWAY_IMAGE=
CF_GATEWAY_ENV_FILE=.env
CF_GATEWAY_CONFIG_FILE=./config/production.yaml
CF_GATEWAY_BIND_ADDRESS=127.0.0.1
CF_GATEWAY_PORT=8080
CF_GATEWAY_STOP_GRACE_PERIOD=120s
# Per-container json-file retention; docker logs remains available. The checked production
# steady-state plus sustained-business-activity model retains at least 7 days by default.
CF_GATEWAY_LOG_MAX_SIZE=64m
CF_GATEWAY_LOG_MAX_FILES=10
